---
import ThemeToggle from './ThemeToggle.astro'

const year = new Date().getFullYear()
---

<footer class="mt-16 border-t border-line">
  <div
    class="mx-auto flex max-w-3xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-6 font-mono text-xs text-ink-2"
  >
    <p class="m-0">© {year} Khoi Van</p>
    <div class="flex items-center gap-2">
      <a href="/rss.xml" class="inline-flex min-h-11 items-center px-2 text-ink-2 no-underline hover:text-ink">
        RSS
      </a>
      <a
        href="https://github.com/tjeuba0"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex min-h-11 items-center px-2 text-ink-2 no-underline hover:text-ink"
      >
        GitHub
      </a>
      <ThemeToggle />
    </div>
  </div>
</footer>

---
const path = Astro.url.pathname

const links = [
  { href: '/blog/', label: 'Posts', match: (p: string) => p.startsWith('/blog') },
  { href: '/portfolio/', label: 'Work', match: (p: string) => p.startsWith('/portfolio') },
  { href: '/about/', label: 'About', match: (p: string) => p.startsWith('/about') },
]
---

<header class="border-b border-line">
  <nav
    class="mx-auto flex max-w-3xl items-center justify-between gap-4 px-4 py-3"
    aria-label="Main"
  >
    <a
      href="/"
      class="inline-flex min-h-11 items-center font-mono text-base font-semibold text-ink no-underline"
    >
      khoivan<span class="text-signal">_</span>
    </a>

    <div class="flex items-center gap-1 font-mono text-sm sm:gap-3">
      {
        links.map(({ href, label, match }) => {
          const current = match(path)
          return (
            <a
              href={href}
              aria-current={current ? 'page' : undefined}
              class:list={[
                'inline-flex min-h-11 items-center border-b-2 px-2 no-underline transition-colors duration-(--dur-1)',
                current
                  ? 'border-signal text-ink'
                  : 'border-transparent text-ink-2 hover:text-ink',
              ]}
            >
              {label}
            </a>
          )
        })
      }
      <a
        href="/search/"
        aria-label="Search (press /)"
        aria-current={path.startsWith('/search') ? 'page' : undefined}
        class="inline-flex size-11 items-center justify-center text-ink-2 no-underline hover:text-ink"
      >
        <svg class="size-5" viewBox="0 0 24 24" aria-hidden="true">
          <path
            fill-rule="evenodd"
            d="M10.5 3.75a6.75 6.75 0 100 13.5 6.75 6.75 0 000-13.5zM2.25 10.5a8.25 8.25 0 1114.59 5.28l4.69 4.69a.75.75 0 11-1.06 1.06l-4.69-4.69A8.25 8.25 0 012.25 10.5z"
            clip-rule="evenodd"></path>
        </svg>
      </a>
    </div>
  </nav>
</header>

<script>
  document.addEventListener('keydown', (e) => {
    if (e.key !== '/' || e.metaKey || e.ctrlKey || e.altKey) return
    const target = e.target as HTMLElement
    if (target.closest('input, textarea, select, [contenteditable="true"]')) return
    if (location.pathname.startsWith('/search')) return
    e.preventDefault()
    location.href = '/search/'
  })
</script>

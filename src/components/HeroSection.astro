---
const links = [
  { href: 'https://github.com/tjeuba0', label: 'github', external: true },
  { href: 'https://www.linkedin.com/in/vanmarch27/', label: 'linkedin', external: true },
  { href: 'mailto:phamdinhkhoivan@gmail.com', label: 'email', external: false },
  { href: '/rss.xml', label: 'rss', external: false },
]
---

<section class="container-narrow pt-10 pb-12 md:pt-16">
  <div class="flex items-center gap-4">
    <img
      src="/avatar.jpg"
      alt="Khoi Van"
      width="56"
      height="56"
      class="size-14 shrink-0 rounded-full object-cover"
    />
    <div class="min-w-0">
      <h1 class="m-0 text-2xl leading-tight font-bold tracking-[-0.02em] md:text-3xl">
        Hey, I'm Van.
      </h1>
      <p class="m-0 font-mono text-xs text-ink-2 md:text-[13px]">
        Senior Android Developer · Hanoi
      </p>
    </div>
  </div>

  <p class="mt-6 mb-0 max-w-[60ch] text-lg leading-relaxed text-ink">
    8+ years building mobile banking apps. I lead an Android team at a major bank and write about
    Clean Architecture, Jetpack Compose, mobile security, and war stories from production.
  </p>

  <ul class="mt-5 mb-0 flex list-none flex-wrap gap-x-1 p-0 font-mono text-sm">
    {
      links.map(({ href, label, external }, i) => (
        <li class="flex items-center">
          {i > 0 && (
            <span class="pr-1 text-ink-2" aria-hidden="true">
              ·
            </span>
          )}
          <a
            href={href}
            class="inline-flex min-h-11 items-center px-1 text-ink-2 no-underline hover:text-signal"
            {...(external && { target: '_blank', rel: 'noopener noreferrer' })}
          >
            {label}
          </a>
        </li>
      ))
    }
  </ul>
</section>

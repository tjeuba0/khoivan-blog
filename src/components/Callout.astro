---
export interface Props {
  type?: 'critical' | 'high' | 'warning' | 'info' | 'note'
  title?: string
  label?: string
}

const { type = 'info', title, label } = Astro.props

const variants = {
  critical: { box: 'bg-crit-bg', tag: 'text-crit', label: 'Critical' },
  high: { box: 'bg-high-bg', tag: 'text-high', label: 'High' },
  warning: { box: 'bg-warn-bg', tag: 'text-warn', label: 'Warning' },
  info: { box: 'bg-info-bg', tag: 'text-info', label: 'Info' },
  note: { box: 'bg-ok-bg', tag: 'text-ok', label: 'Note' },
}

const v = variants[type]
---

<aside
  class:list={[
    'my-6 grid grid-cols-1 gap-x-4 gap-y-1 rounded-2 px-4 py-3.5 text-[15px] sm:grid-cols-[auto_minmax(0,1fr)]',
    v.box,
  ]}
>
  <span class:list={['pt-1 font-mono text-[11px] leading-none font-semibold tracking-wider uppercase', v.tag]}>
    {label ?? v.label}
  </span>
  <div class="min-w-0 text-ink [&_li]:text-[15px] [&_p]:text-[15px] [&_p]:opacity-100 [&>*:last-child]:mb-0">
    {title && <p class="mb-1 font-semibold">{title}</p>}
    <slot />
  </div>
</aside>

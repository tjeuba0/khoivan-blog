---
export interface Props {
  title: string
}

const { title } = Astro.props
const email = 'phamdinhkhoivan@gmail.com'
---

<section class="mt-16 rounded-2 border border-line bg-surface p-6 md:p-8">
  <h2 class="m-0 text-xl font-semibold">{title}</h2>
  <p class="mt-2 mb-0 max-w-[56ch] text-ink-2">
    I'm always open to discussing technology, sharing experiences, or collaborating on interesting
    projects.
  </p>
  <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2">
    <a
      href={`mailto:${email}`}
      class="inline-flex min-h-11 items-center rounded-1 bg-signal px-5 font-semibold text-paper no-underline hover:opacity-90"
    >
      Get in touch
    </a>
    <span class="font-mono text-sm text-ink-2 select-all">{email}</span>
  </div>
</section>

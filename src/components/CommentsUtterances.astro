---
// Utterances comments component - Alternative to Giscus
// Simpler setup, uses GitHub Issues instead of Discussions
// Anti-spam: Requires GitHub login to comment
---

<section class="mt-12 border-t border-line pt-8">
  <h2 class="mt-0 mb-6 font-mono text-xs font-semibold tracking-wider text-ink-2 uppercase">
    Comments
  </h2>

  <div id="utterances-container"></div>
</section>

<script>
  const container = document.getElementById('utterances-container')
  const themeFor = () =>
    document.documentElement.classList.contains('dark') ? 'github-dark' : 'github-light'

  if (container) {
    const script = document.createElement('script')
    script.src = 'https://utteranc.es/client.js'
    script.setAttribute('repo', 'tjeuba0/khoivan-blog')
    script.setAttribute('issue-term', 'pathname')
    script.setAttribute('label', 'comments')
    script.setAttribute('theme', themeFor())
    script.setAttribute('crossorigin', 'anonymous')
    script.async = true
    container.appendChild(script)

    // Keep the iframe in sync with the site theme toggle
    new MutationObserver(() => {
      const frame = document.querySelector<HTMLIFrameElement>('.utterances-frame')
      frame?.contentWindow?.postMessage(
        { type: 'set-theme', theme: themeFor() },
        'https://utteranc.es'
      )
    }).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] })
  }
</script>

<style is:global>
  .utterances {
    max-width: 100% !important;
  }

  .utterances-frame {
    border: none !important;
  }
</style>

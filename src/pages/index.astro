---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import PostRow from '../components/PostRow.astro'
import HeroSection from '../components/HeroSection.astro'

const allPosts = await getCollection('blog')
const posts = allPosts
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 6)
---

<BaseLayout title="Khoi Van" description="Personal blog about Android development, software engineering, and life in Hanoi">
  <HeroSection />

  <section class="container-narrow pb-8">
    <h2 class="mt-0 mb-6 font-mono text-xs font-semibold tracking-wider text-ink-2 uppercase">
      Recent posts
    </h2>
    <div>
      {posts.map((post) => <PostRow post={post} headingLevel="h3" />)}
    </div>

    <a
      href="/blog/"
      class="mt-8 inline-flex min-h-11 items-center font-mono text-sm text-signal no-underline hover:underline"
    >
      All posts →
    </a>
  </section>
</BaseLayout>

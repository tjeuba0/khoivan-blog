---
import BaseLayout from '../layouts/BaseLayout.astro'
import Search from 'astro-pagefind/components/Search'
---

<BaseLayout title="Search | Khoi Van Blog" description="Search through all blog posts and content">
  <div class="container-narrow pt-10 pb-8 md:pt-14">
    <h1 class="m-0 text-3xl leading-tight font-bold tracking-[-0.02em] md:text-4xl">Search</h1>
    <p class="mt-2 mb-8 text-ink-2">Find a post by title, topic, or a phrase you remember.</p>

    <div class="min-h-[400px]">
      <Search
        id="search"
        className="pagefind-ui"
        uiOptions={{
          showImages: false,
          showSubResults: true,
          excerptLength: 150,
        }}
      />
    </div>
  </div>
</BaseLayout>

<script>
  // Focus the field so "/" from the header lands ready to type
  const focusInput = (attempts = 20) => {
    const input = document.querySelector<HTMLInputElement>('.pagefind-ui__search-input')
    if (input) input.focus()
    else if (attempts > 0) setTimeout(() => focusInput(attempts - 1), 100)
  }
  focusInput()
</script>

<style>
  :global(.pagefind-ui) {
    --pagefind-ui-primary: var(--color-signal);
    --pagefind-ui-text: var(--color-ink);
    --pagefind-ui-background: var(--color-paper);
    --pagefind-ui-border: var(--color-line);
    --pagefind-ui-tag: var(--color-surface);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: var(--radius-2);
    --pagefind-ui-font: var(--font-sans);
  }

  :global(.pagefind-ui__search-input) {
    font-size: 1.0625rem;
  }

  :global(.pagefind-ui__result-title) {
    font-weight: 600;
  }

  :global(.pagefind-ui__result-link) {
    color: var(--color-ink);
    text-decoration: none;
  }

  :global(.pagefind-ui__result-link:hover) {
    color: var(--color-signal);
  }

  :global(.pagefind-ui__result-excerpt) {
    color: var(--color-ink-2);
  }

  :global(.pagefind-ui mark) {
    background: transparent;
    color: var(--color-signal);
    font-weight: 600;
  }
</style>

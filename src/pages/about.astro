---
import BaseLayout from '../layouts/BaseLayout.astro'
import ContactCta from '../components/ContactCta.astro'
import LanguageTabs from '../components/LanguageTabs.astro'
import { experienceYears } from '../lib/site'
import { profilePage, SITE_URL } from '../lib/schema'

const skills = {
  'Core Expertise': [
    'Android Architecture',
    'Performance Optimization',
    'Security Best Practices',
    'Code Review & Mentoring',
    'Technical Leadership',
    'System Design',
  ],
  'Android Stack': [
    'Jetpack Compose',
    'Kotlin Coroutines & Flow',
    'MVVM/Clean Architecture',
    'Dependency Injection (Hilt/Dagger)',
    'Android Jetpack Libraries',
    'Material Design 3',
  ],
  'Banking/Fintech': [
    'Mobile Banking Architecture',
    'Payment Gateway Integration',
    'Biometric & PIN Security',
    'End-to-End Encryption',
    'PCI DSS Compliance',
    'Third-party SDK Integration',
  ],
  'Engineering Practices': [
    'Agile/Scrum Leadership',
    'CI/CD Pipeline Design',
    'Unit & UI Testing',
    'Git Flow Strategy',
    'Documentation',
    'Team Collaboration',
  ],
}

const experience = [
  {
    company: 'VietinBank',
    role: 'Senior Android Developer',
    period: 'Jun 2024 - Present',
    description:
      'Leading Android team for VietinBank\'s corporate banking application. Responsible for technical architecture, code quality, and mentoring team members.',
  },
  {
    company: 'Freelance (Upwork)',
    role: 'Android Developer',
    period: 'Apr 2024 - Present',
    description:
      'Developing Android applications for international clients, providing technical consultation and performance optimization.',
  },
  {
    company: 'VNPAY',
    role: 'Android Developer',
    period: 'Oct 2018 - Apr 2024',
    description:
      'Developed mobile banking applications for 8+ major Vietnamese banks. Key member in flagship projects including Agribank OMNI, VietinBank eFAST, and HDBank Mobile Banking.',
  },
  {
    company: 'FPT Software',
    role: 'Android Developer',
    period: 'Oct 2017 - Oct 2018',
    description:
      'Developed automotive and Android TV applications for international clients including Pioneer and Netgear.',
  },
]
---

<BaseLayout
  title="About - Phạm Đình Khôi Văn"
  schema={[profilePage(`${SITE_URL}/about/`)]}
  description={`Senior Android Developer với ${experienceYears}+ năm kinh nghiệm chuyên sâu trong phát triển ứng dụng mobile banking, lead các dự án fintech quy mô lớn tại Việt Nam`}
>
  <div class="container-narrow pt-10 pb-8 md:pt-14">
    <header class="flex items-center gap-5">
      <img
        src="/avatar.jpg"
        alt="Phạm Đình Khôi Văn"
        width="88"
        height="88"
        class="size-[88px] shrink-0 rounded-full object-cover"
      />
      <div class="min-w-0">
        <h1 class="m-0 text-3xl leading-tight font-bold tracking-[-0.02em] md:text-4xl">
          Phạm Đình Khôi Văn
        </h1>
        <p class="m-0 mt-1 font-mono text-xs text-ink-2 md:text-[13px]">
          Senior Android Developer · Hanoi, Vietnam
        </p>
        <ul class="mt-1 mb-0 flex list-none flex-wrap gap-x-1 p-0 font-mono text-sm">
          {
            [
              ['github', 'https://github.com/tjeuba0'],
              ['linkedin', 'https://www.linkedin.com/in/vanmarch27/'],
              ['email', 'mailto:phamdinhkhoivan@gmail.com'],
            ].map(([label, href], i) => (
              <li class="flex items-center">
                {i > 0 && <span class="pr-1 text-ink-2" aria-hidden="true">·</span>}
                <a href={href} target={href.startsWith('http') ? '_blank' : undefined} rel="noopener noreferrer" class="inline-flex min-h-11 items-center px-1 text-ink-2 no-underline hover:text-signal">
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </header>

    <LanguageTabs id="bio" labels={{ en: 'About me', vi: 'Giới thiệu' }}>
      <div slot="en" class="prose-content">
        <p>
          Hi! I'm Pham Dinh Khoi Van, a Senior Android Developer with over {experienceYears} years of experience 
          specializing in mobile banking applications. Currently, I'm working at VietinBank, one of 
          Vietnam's largest banks, where I lead the Android team for corporate banking solutions.
        </p>
        <p>
          Throughout my career, I've contributed to mobile banking solutions for most major Vietnamese 
          banks including VPBank, HDBank, Agribank, CPBank, SGBank, and ABBank. As a key member of 
          the Agribank OMNI project, I helped deliver one of Vietnam's largest digital banking 
          transformations, serving millions of customers nationwide.
        </p>
        <p>
          As a Senior Developer, I focus not only on writing clean, maintainable code but also on 
          mentoring junior developers, conducting architecture reviews, and making critical technical 
          decisions. My deep passion for Android internals - from custom ROMs to system-level 
          optimizations - enables me to design high-performance, secure solutions that meet the 
          stringent requirements of banking applications.
        </p>
        <p>
          Outside of work, I enjoy challenging myself through sports like football, running, and 
          especially trail running. This blog is where I share technical insights, lessons learned, 
          and stories from my journey as an Android Developer in Vietnam's dynamic fintech landscape.
        </p>
      </div>
      <div slot="vi" class="prose-content">
        <p>
          Xin chào! Tôi là Phạm Đình Khôi Văn, Senior Android Developer với hơn {experienceYears} năm
          kinh nghiệm, chuyên về ứng dụng mobile banking. Hiện tôi làm việc tại VietinBank, một trong
          những ngân hàng lớn nhất Việt Nam, và dẫn dắt đội Android phát triển giải pháp ngân hàng cho
          khách hàng doanh nghiệp.
        </p>
        <p>
          Trong sự nghiệp, tôi đã tham gia phát triển giải pháp mobile banking cho hầu hết các ngân hàng
          lớn tại Việt Nam như VPBank, HDBank, Agribank, CPBank, SGBank và ABBank. Là thành viên chủ chốt
          của dự án Agribank OMNI, tôi góp phần đưa vào vận hành một trong những dự án chuyển đổi số ngân
          hàng lớn nhất Việt Nam, phục vụ hàng triệu khách hàng trên cả nước.
        </p>
        <p>
          Ở vai trò Senior Developer, tôi không chỉ tập trung viết code sạch, dễ bảo trì mà còn hướng dẫn
          các bạn junior, review kiến trúc và đưa ra những quyết định kỹ thuật quan trọng. Niềm đam mê
          với Android internals, từ custom ROM đến tối ưu ở tầng hệ thống, giúp tôi thiết kế những giải
          pháp hiệu năng cao và bảo mật, đáp ứng yêu cầu khắt khe của ứng dụng ngân hàng.
        </p>
        <p>
          Ngoài công việc, tôi thích thử thách bản thân với thể thao: bóng đá, chạy bộ và đặc biệt là
          chạy trail. Blog này là nơi tôi chia sẻ kiến thức kỹ thuật, những bài học rút ra và các câu
          chuyện trên hành trình làm Android Developer giữa thị trường fintech sôi động của Việt Nam.
        </p>
      </div>
    </LanguageTabs>

    <section class="mt-12">
      <h2 class="mt-0 mb-6 font-mono text-xs font-semibold tracking-wider text-ink-2 uppercase">Experience</h2>
      <ol class="m-0 list-none p-0">
        {
          experience.map((job) => (
            <li class="grid grid-cols-1 gap-x-6 gap-y-1 border-t border-line py-5 first:border-t-0 first:pt-0 sm:grid-cols-[8rem_minmax(0,1fr)]">
              <p class="m-0 pt-1 font-mono text-xs text-ink-2 tabular-nums sm:text-[13px]">{job.period}</p>
              <div class="min-w-0">
                <h3 class="m-0 text-lg leading-snug font-semibold">{job.role}</h3>
                <p class="m-0 font-mono text-sm text-signal">{job.company}</p>
                <p class="mt-2 mb-0 text-[15px] leading-relaxed text-ink-2">{job.description}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="mt-12">
      <h2 class="mt-0 mb-6 font-mono text-xs font-semibold tracking-wider text-ink-2 uppercase">Technical skills</h2>
      <div class="grid gap-x-8 gap-y-6 sm:grid-cols-2">
        {
          Object.entries(skills).map(([category, items]) => (
            <div>
              <h3 class="mt-0 mb-2 text-base font-semibold">{category}</h3>
              <ul class="m-0 list-none space-y-1 p-0 text-[15px] text-ink-2">
                {items.map((skill) => <li>{skill}</li>)}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <ContactCta title="Let's connect" />
  </div>
</BaseLayout>

---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import PostRow from '../components/PostRow.astro'

const recent = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3)
---

<BaseLayout title="Page not found" description="This page doesn't exist on khoivan.dev." noindex>
  <div class="container-narrow pt-10 pb-8 md:pt-14">
    <p class="m-0 font-mono text-sm text-signal">404</p>
    <h1 class="mt-2 mb-3 text-3xl leading-tight font-bold tracking-[-0.02em] md:text-4xl">
      This page doesn't exist
    </h1>
    <p class="m-0 max-w-[56ch] text-ink-2">
      The link may be old, or the post was moved. Try search, or start from one of the latest posts.
    </p>

    <div class="mt-6 flex flex-wrap gap-x-5 font-mono text-sm">
      <a href="/search/" class="inline-flex min-h-11 items-center text-signal no-underline hover:underline">
        Search posts →
      </a>
      <a href="/blog/" class="inline-flex min-h-11 items-center text-signal no-underline hover:underline">
        All posts →
      </a>
    </div>

    <h2 class="mt-12 mb-6 font-mono text-xs font-semibold tracking-wider text-ink-2 uppercase">
      Latest posts
    </h2>
    <div>
      {recent.map((post) => <PostRow post={post} headingLevel="h3" />)}
    </div>
  </div>
</BaseLayout>

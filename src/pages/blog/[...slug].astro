---
import { getCollection, render } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import Comments from '../../components/CommentsUtterances.astro'
import ImageLightbox from '../../components/ImageLightbox.astro'
import Callout from '../../components/Callout.astro'
import Badge from '../../components/Badge.astro'
import Chip from '../../components/Chip.astro'
import Toc from '../../components/Toc.astro'
import ReadingProgress from '../../components/ReadingProgress.astro'
import { categoryUrl, isoDate, postUrl, readingMinutes, tagUrl } from '../../lib/post'

export async function getStaticPaths() {
  const posts = await getCollection('blog')

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }))
}

const { post } = Astro.props
const { Content, headings } = await render(post)
const readingTime = readingMinutes(post.body)

// Neighbours by publish date, newest first
const published = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
const index = published.findIndex((p) => p.id === post.id)
const newer = index > 0 ? published[index - 1] : undefined
const older = index >= 0 ? published[index + 1] : undefined

const pageUrl = new URL(postUrl(post), Astro.site).toString()
const shareLinks = [
  { label: 'LinkedIn', href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(pageUrl)}` },
  { label: 'Facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(pageUrl)}` },
]
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
  author={post.data.author}
  publishedDate={post.data.pubDate}
  tags={post.data.tags}
>
  {readingTime > 6 && <ReadingProgress target="#post-body" />}

  <article class="container-narrow py-8 md:py-12" data-pagefind-body>
    <a
      href="/blog/"
      data-back-link
      data-pagefind-ignore="all"
      class="group mb-6 inline-flex min-h-11 items-center gap-1.5 font-mono text-sm text-ink-2 no-underline hover:text-ink"
    >
      <span class="transition-transform group-hover:-translate-x-0.5" aria-hidden="true">←</span>
      Posts
    </a>

    <!-- Article Header -->
    <header class="mb-10">
      <a
        href={categoryUrl(post.data.category)}
        data-pagefind-ignore="all"
        class="font-mono text-xs text-signal no-underline hover:underline"
      >
        {post.data.category}/
      </a>
      <h1 class="mt-2 mb-3 text-2xl leading-tight font-bold tracking-[-0.02em] md:text-[2.5rem]">
        {post.data.title}
      </h1>
      <p class="m-0 font-mono text-xs text-ink-2 md:text-[13px]">
        <time datetime={post.data.pubDate.toISOString()}>{isoDate(post.data.pubDate)}</time>
        <span aria-hidden="true"> · </span>{post.data.author}
        <span aria-hidden="true"> · </span>{readingTime} min
      </p>
    </header>

    <hr class="mt-0 mb-8 border-line" />

    <!-- Article Content -->
    <div id="post-body" class="relative">
      <Toc headings={headings} />
      <div class="prose-content">
        <Content components={{ Callout, Badge }} />
      </div>
    </div>

    <!-- Image Lightbox -->
    <ImageLightbox />

    <!-- Article Footer -->
    <footer class="mt-16 border-t border-line pt-8" data-pagefind-ignore="all">
      {
        post.data.tags.length > 0 && (
          <div class="mb-8 flex flex-wrap gap-2">
            {post.data.tags.map((tag) => (
              <Chip href={tagUrl(tag)}>{tag}</Chip>
            ))}
          </div>
        )
      }

      <div class="mb-10 flex flex-wrap items-center gap-x-1 gap-y-2 font-mono text-sm">
        <span class="mr-2 text-xs tracking-wider text-ink-2 uppercase">Share</span>
        <button
          type="button"
          data-copy-link={pageUrl}
          class="inline-flex min-h-11 cursor-pointer items-center px-2 text-ink-2 hover:text-signal"
        >
          Copy link
        </button>
        {
          shareLinks.map(({ label, href }) => (
            <a
              href={href}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-11 items-center px-2 text-ink-2 no-underline hover:text-signal"
            >
              {label}
            </a>
          ))
        }
      </div>

      {
        (newer || older) && (
          <nav class="grid gap-4 sm:grid-cols-2" aria-label="More posts">
            {older && (
              <a href={postUrl(older)} class="group rounded-2 border border-line p-4 no-underline hover:border-signal">
                <span class="font-mono text-xs text-ink-2">← Older</span>
                <span class="mt-1 block leading-snug font-semibold text-ink group-hover:text-signal">
                  {older.data.title}
                </span>
              </a>
            )}
            {newer && (
              <a
                href={postUrl(newer)}
                class="group rounded-2 border border-line p-4 text-right no-underline hover:border-signal sm:col-start-2"
              >
                <span class="font-mono text-xs text-ink-2">Newer →</span>
                <span class="mt-1 block leading-snug font-semibold text-ink group-hover:text-signal">
                  {newer.data.title}
                </span>
              </a>
            )}
          </nav>
        )
      }
    </footer>
  </article>

  <section class="container-narrow pb-8">
    <Comments />
  </section>
</BaseLayout>

<script>
  const back = document.querySelector<HTMLAnchorElement>('[data-back-link]')
  back?.addEventListener('click', (e) => {
    const from = document.referrer ? new URL(document.referrer) : null
    if (from?.origin === location.origin && history.length > 1) {
      e.preventDefault()
      history.back()
    }
  })

  document.querySelectorAll<HTMLButtonElement>('[data-copy-link]').forEach((button) => {
    button.addEventListener('click', async () => {
      const label = button.textContent
      try {
        await navigator.clipboard.writeText(button.dataset.copyLink!)
        button.textContent = 'Copied'
      } catch {
        button.textContent = 'Copy failed'
      }
      setTimeout(() => (button.textContent = label), 1600)
    })
  })
</script>
